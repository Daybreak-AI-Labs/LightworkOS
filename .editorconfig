# Editor settings shared across the repository. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi,rs,toml,ps1}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,mjs,cjs,ts,tsx,svelte,css,html}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Vendored third-party files are kept byte-for-byte as published upstream.
[packages/maverick-dashboard/maverick_dashboard/static/{cytoscape-*,swagger-ui-*}]
trim_trailing_whitespace = false
insert_final_newline = false
