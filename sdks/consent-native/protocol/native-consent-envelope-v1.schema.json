{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightwork.invalid/schemas/native-consent-envelope-v1.schema.json",
  "title": "Lightwork native consent request envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "application_ref",
    "application_authority_sha256",
    "tenant_id",
    "application_id",
    "platform",
    "device_id",
    "device_revision",
    "key_revision",
    "sdk_version",
    "public_client_revision",
    "public_client_record_sha256",
    "publication_sha256",
    "publication_bundle_sha256",
    "configuration_sha256",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "standards_contract_sha256",
    "request_id",
    "counter",
    "issued_at",
    "expires_at",
    "operation",
    "payload",
    "signature_hex"
  ],
  "properties": {
    "schema": {"const": "lightwork.native-consent-envelope.v1"},
    "application_ref": {"$ref": "#/$defs/ref"},
    "application_authority_sha256": {"$ref": "#/$defs/digest"},
    "tenant_id": {"$ref": "#/$defs/ref"},
    "application_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,254}$"},
    "platform": {"enum": ["android", "fireos", "ios", "roku", "tizen", "tvos", "webos"]},
    "device_id": {"$ref": "#/$defs/ref"},
    "device_revision": {"$ref": "#/$defs/positiveInteger"},
    "key_revision": {"$ref": "#/$defs/positiveInteger"},
    "sdk_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "public_client_revision": {"$ref": "#/$defs/positiveInteger"},
    "public_client_record_sha256": {"$ref": "#/$defs/digest"},
    "publication_sha256": {"$ref": "#/$defs/digest"},
    "publication_bundle_sha256": {"$ref": "#/$defs/digest"},
    "configuration_sha256": {"$ref": "#/$defs/digest"},
    "policy_id": {"$ref": "#/$defs/ref"},
    "policy_version": {"$ref": "#/$defs/positiveInteger"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "standards_contract_sha256": {"$ref": "#/$defs/digest"},
    "request_id": {"$ref": "#/$defs/ref"},
    "counter": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issued_at": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "integer", "minimum": 1},
    "operation": {
      "enum": [
        "bootstrap_profile",
        "configuration",
        "current_preferences",
        "link_profile",
        "privacy_signals",
        "record_preferences",
        "revoke_profile",
        "rights_request"
      ]
    },
    "payload": {"type": "object", "maxProperties": 16},
    "signature_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  }
}
