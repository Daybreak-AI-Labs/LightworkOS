;;; maverick-control-tests.el --- Deferred async ownership regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(load-file (expand-file-name "../maverick.el" (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest maverick-control-deadline-fences-late-result ()
  (let ((maverick--requests (make-hash-table :test 'equal))
        properties filter sentinel timer callbacks deleted)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args) (setq filter (plist-get args :filter)
                                         sentinel (plist-get args :sentinel)) 'fake-process))
              ((symbol-function 'process-live-p) (lambda (_) (not deleted)))
              ((symbol-function 'process-status) (lambda (_) 'exit))
              ((symbol-function 'process-exit-status) (lambda (_) 0))
              ((symbol-function 'delete-process) (lambda (_) (setq deleted t)))
              ((symbol-function 'process-put) (lambda (_ key value) (push (cons key value) properties)))
              ((symbol-function 'process-get) (lambda (_ key) (alist-get key properties)))
              ((symbol-function 'run-at-time) (lambda (_seconds _repeat callback) (setq timer callback) 'fake-timer))
              ((symbol-function 'cancel-timer) (lambda (_) nil)))
      (maverick--async "status" '("status") (lambda (ok text) (push (cons ok text) callbacks)))
      (should-not callbacks)
      (should (gethash "status" maverick--requests))
      (funcall timer)
      (should deleted)
      (should (= 1 (length callbacks)))
      (should-not (caar callbacks))
      (should (string-match-p "unconfirmed" (cdar callbacks)))
      (funcall filter 'fake-process "late success")
      (funcall sentinel 'fake-process "finished")
      (should (= 1 (length callbacks)))
      (should-not (gethash "status" maverick--requests)))))

(ert-deftest maverick-halt-requires-exact-acknowledged-scope ()
  (dolist (reply '("{}" "{\"command\":\"halt\",\"acknowledged\":true,\"scope\":\"remote\",\"halt_file_present\":true,\"work_stopped\":false}"
                   "{\"command\":\"halt\",\"acknowledged\":true,\"scope\":\"local\",\"halt_file_present\":true,\"work_stopped\":true}"))
    (let (last-message)
      (cl-letf (((symbol-function 'maverick--async) (lambda (_channel _args callback) (funcall callback t reply)))
                ((symbol-function 'message) (lambda (format &rest args) (setq last-message (apply #'format format args)))))
        (maverick--checked-halt "halt" t)
        (should (string-match-p "unconfirmed" last-message))))))
