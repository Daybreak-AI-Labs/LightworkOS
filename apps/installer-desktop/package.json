{
  "name": "@maverick/installer-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Tauri source bootstrap for Lightwork",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "svelte": "^5.56.8"
  },
  "pnpm": {
    "overrides": {
      "devalue": "5.9.4",
      "undici": "7.30.1",
      "deepmerge": "file:../../vendor/js/deepmerge"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.12"
  }
}
