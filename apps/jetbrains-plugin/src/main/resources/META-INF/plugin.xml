<idea-plugin>
  <id>dev.maverick.jetbrains</id>
  <name>Lightwork</name>
  <vendor url="https://github.com/Daybreak-AI-Labs/LightworkOS">Daybreak Labs</vendor>
  <description>Watch Lightwork agent runs live inside the IDE (streams the
  self-hosted dashboard's SSE event feed).</description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable id="lightwork.dashboard" displayName="Lightwork Dashboard"
                             instance="dev.maverick.DashboardConfigurable"/>
    <toolWindow id="Lightwork Runs" anchor="bottom"
                factoryClass="dev.maverick.RunsToolWindowFactory"/>
  </extensions>
</idea-plugin>
