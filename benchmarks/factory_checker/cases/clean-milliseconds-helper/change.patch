index fb0876b..cd89352 100644
--- a/timing.py
+++ b/timing.py
@@ -4,3 +4,8 @@
 def elapsed(start, end):
     """Seconds between two time.monotonic() readings."""
     return end - start
+
+
+def elapsed_ms(start, end):
+    """Milliseconds between two time.monotonic() readings, for display."""
+    return elapsed(start, end) * 1000
