diff --git a/pool_test.py b/pool_test.py
index 75e5dda..e6666c8 100644
--- a/pool_test.py
+++ b/pool_test.py
@@ -5,3 +5,15 @@ def test_gives_the_connection_back():
     pool = Pool(2)
     assert with_conn(pool, lambda conn: 3) == 3
     assert pool.available == 2
+
+
+def test_retries_once():
+    pool, calls = Pool(2), []
+
+    def flaky(conn):
+        calls.append(conn)
+        if len(calls) == 1:
+            raise ConnectionError("dropped")
+        return 4
+    assert with_conn(pool, flaky) == 4
+    assert len(calls) == 2
