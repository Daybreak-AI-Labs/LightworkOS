diff --git a/pool.py b/pool.py
index cec4943..75fb9ab 100644
--- a/pool.py
+++ b/pool.py
@@ -19,9 +19,15 @@ class Pool:
 
 
 def with_conn(pool, fn):
-    """``fn(conn)`` with a pooled connection, always given back."""
-    conn = pool.acquire()
-    try:
-        return fn(conn)
-    finally:
+    """``fn(conn)`` with a pooled connection; one retry with a fresh
+    connection on ConnectionError."""
+    for attempt in range(2):
+        conn = pool.acquire()
+        try:
+            result = fn(conn)
+        except ConnectionError:
+            if attempt == 1:
+                raise
+            continue
         pool.release(conn)
