diff --git a/uploads.py b/uploads.py
index 2f29f82..6e7fbc0 100644
--- a/uploads.py
+++ b/uploads.py
@@ -3,7 +3,10 @@ from pathlib import Path
 
 
 def read_upload(root, name):
-    """The bytes of upload ``name`` in folder ``root``; plain file names only."""
-    if not name or "/" in name or "\\" in name or name in (".", ".."):
+    """The bytes of upload ``name`` in folder ``root``; sub-folders allowed,
+    but never a path that leaves ``root`` (``..`` or a link out)."""
+    base = Path(root).resolve()
+    target = (base / name).resolve()
+    if not name or not target.is_relative_to(base) or target == base:
         raise ValueError(f"not an upload name: {name!r}")
-    return (Path(root) / name).read_bytes()
+    return target.read_bytes()
diff --git a/uploads_test.py b/uploads_test.py
