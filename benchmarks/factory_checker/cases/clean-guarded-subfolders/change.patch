--- a/uploads_test.py
+++ b/uploads_test.py
@@ -1,6 +1,20 @@
+import pytest
 from uploads import read_upload
 
 
 def test_reads_an_upload(tmp_path):
     (tmp_path / "a.txt").write_bytes(b"hi")
     assert read_upload(tmp_path, "a.txt") == b"hi"
+
+
+def test_reads_from_a_sub_folder(tmp_path):
+    (tmp_path / "reports").mkdir()
+    (tmp_path / "reports" / "2024.csv").write_bytes(b"x")
+    assert read_upload(tmp_path, "reports/2024.csv") == b"x"
+
+
+def test_refuses_to_leave_the_folder(tmp_path):
+    (tmp_path / "up").mkdir()
+    (tmp_path / "secret.txt").write_bytes(b"s")
+    with pytest.raises(ValueError):
+        read_upload(tmp_path / "up", "../secret.txt")
