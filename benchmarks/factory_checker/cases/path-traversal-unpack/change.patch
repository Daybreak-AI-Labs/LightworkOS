diff --git a/unpack.py b/unpack.py
index bbc017a..06439bd 100644
--- a/unpack.py
+++ b/unpack.py
@@ -3,12 +3,12 @@ from pathlib import Path
 
 
 def extract(members, dest):
-    """Write each name -> bytes in ``members`` under ``dest``; refuse a name
-    that would land outside it."""
-    dest = Path(dest).resolve()
+    """Write each name -> bytes in ``members`` under ``dest``. Names ending
+    with '/' are folder entries and are skipped."""
+    dest = Path(dest)
     for name, data in members.items():
-        target = (dest / name).resolve()
