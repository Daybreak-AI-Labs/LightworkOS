diff --git a/counting.py b/counting.py
index 65e9fa2..4d4bc94 100644
--- a/counting.py
+++ b/counting.py
@@ -1,7 +1,10 @@
 """Count the lines of a file."""
+import subprocess
 
 
 def count_lines(path):
-    """The number of lines in ``path``."""
-    with open(path, "rb") as fh:
-        return sum(1 for _ in fh)
+    """The number of lines in ``path``, counted by ``wc -l``. The path is one
+    argument, never shell text, and ``--`` stops it reading as an option."""
+    done = subprocess.run(["wc", "-l", "--", path], capture_output=True, text=True,
+                          check=True)
+    return int(done.stdout.split()[0])
