diff --git a/memo.py b/memo.py
index d072047..f036cf0 100644
--- a/memo.py
+++ b/memo.py
@@ -12,6 +12,9 @@ class OnceCache:
 
     def get(self, key, factory):
         with self._lock:
-            if key not in self._values:
-                self._values[key] = factory()
-            return self._values[key]
+            if key in self._values:
+                return self._values[key]
+        value = factory()  # outside the lock: other keys need not wait
+        with self._lock:
+            self._values[key] = value
+        return value
diff --git a/memo_test.py b/memo_test.py
index d5a9247..e53f463 100644
--- a/memo_test.py
+++ b/memo_test.py
@@ -1,3 +1,6 @@
+import threading
+import time
+
 from memo import OnceCache
 
 
@@ -6,3 +9,18 @@ def test_runs_factory_once():
     for _ in range(3):
         cache.get("a", lambda: calls.append(1) or 7)
     assert calls == [1]
+
+
+def test_different_keys_run_in_parallel():
+    cache = OnceCache()
+
+    def slow():
+        time.sleep(0.5)
+        return 1
+    started = time.monotonic()
+    threads = [threading.Thread(target=cache.get, args=(k, slow)) for k in "ab"]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert time.monotonic() - started < 0.9
