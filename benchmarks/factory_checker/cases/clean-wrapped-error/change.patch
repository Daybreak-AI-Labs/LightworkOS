-from settings import load
+import pytest
+from settings import ConfigError, load
 
 
 def test_loads(tmp_path):
     f = tmp_path / "s.json"
     f.write_text('{"a": 1}')
     assert load(f) == {"a": 1}
+
+
+def test_names_the_broken_file(tmp_path):
+    f = tmp_path / "s.json"
+    f.write_text("{")
+    with pytest.raises(ConfigError, match="s.json"):
+        load(f)
