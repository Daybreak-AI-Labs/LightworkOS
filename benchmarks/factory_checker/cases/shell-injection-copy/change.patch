 """Copy files."""
-import shutil
+import os
 
 
 def copy_file(src, dest):
-    """Copy the contents of ``src`` to ``dest``."""
-    shutil.copyfile(src, dest)
+    """Copy ``src`` to ``dest``, keeping its mode and times (``cp -p``)."""
