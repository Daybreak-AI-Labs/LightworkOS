+
+
+def test_keeps_the_mode(tmp_path):
+    (tmp_path / "a").write_text("x")
+    os.chmod(tmp_path / "a", 0o600)
+    copy_file(str(tmp_path / "a"), str(tmp_path / "b"))
+    assert os.stat(tmp_path / "b").st_mode & 0o777 == 0o600
